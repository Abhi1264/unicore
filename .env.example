# Copy to .env for local overrides. Every value here has a working default in
# docker-compose.yml, so a plain `docker compose up` needs none of this.
#
# Everything marked PRODUCTION below is a known-public development value. The
# API validates these at boot and refuses to start when APP_ENV=production, so
# a deployment cannot accidentally inherit them. Generate replacements with:
#   openssl rand -base64 48

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
# Institutes are served at <slug>.APP_BASE_DOMAIN; the control plane lives at
# PLATFORM_HOST and is the only host that serves superadmin routes.
APP_BASE_DOMAIN=localhost
PLATFORM_HOST=app.localhost
API_ADDR=:8080
WEB_URL=http://localhost:3000
# Extra browser origins allowed to send credentialed requests. Any host under
# APP_BASE_DOMAIN is allowed automatically, so this is only for exceptions.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://app.localhost:3000

# ── Postgres ──────────────────────────────────────────────────────────────────
# The owner role. Used only to create the schema and run migrations.
POSTGRES_USER=unicore
POSTGRES_PASSWORD=unicore
POSTGRES_DB=unicore
DATABASE_MIGRATE_URL=postgres://unicore:unicore@localhost:5432/unicore?sslmode=disable

# The runtime role, created by infra/postgres/init.sh as NOSUPERUSER NOBYPASSRLS.
# Tenant isolation is row-level security, and a superuser connection ignores RLS
# entirely, so the API must never connect with the owner URL above. It checks
# this at startup and exits if the role can bypass RLS.
# PRODUCTION: replace before deploying
APP_DB_PASSWORD=dev-only-app-db-password
DATABASE_URL=postgres://unicore_app:dev-only-app-db-password@localhost:5432/unicore?sslmode=disable

# ── Redis ─────────────────────────────────────────────────────────────────────
# Holds refresh-token state and rate-limit counters. Counters must be shared,
# not in-process, or limits break as soon as there is more than one API replica.
REDIS_URL=redis://localhost:6379/0

# ── NATS ──────────────────────────────────────────────────────────────────────
NATS_URL=nats://localhost:4222

# ── Auth ──────────────────────────────────────────────────────────────────────
# Must differ from each other: a shared key would let a refresh token be
# replayed as an access token.
# PRODUCTION: replace before deploying
JWT_ACCESS_SECRET=dev-only-access-secret-not-for-production-0001
# PRODUCTION: replace before deploying
JWT_REFRESH_SECRET=dev-only-refresh-secret-not-for-production-0002
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ── Payments ──────────────────────────────────────────────────────────────────
# HMAC-SHA256 key for the gateway webhook. Without it the payment confirmation
# endpoint would accept anything, so it is mandatory in production.
# PRODUCTION: replace before deploying
PAYMENT_WEBHOOK_SECRET=dev-only-payment-webhook-secret-not-for-production

# ── Observability ─────────────────────────────────────────────────────────────
# Bearer token for /metrics. Mandatory in production; the endpoint exposes
# route templates, error rates and queue depth.
# PRODUCTION: replace before deploying
METRICS_TOKEN=dev-only-metrics-token-not-for-production

# ── Storage & uploads ─────────────────────────────────────────────────────────
STORAGE_PATH=./storage
MAX_UPLOAD_BYTES=10485760

# ── Rate limiting ─────────────────────────────────────────────────────────────
# General budget per IP and per authenticated user.
RATE_LIMIT_IP=100
RATE_LIMIT_USER=60
# Tight budget for payments, enrollments, and bulk imports.
RATE_LIMIT_WRITE=10
RATE_LIMIT_WINDOW=1m
# Tighter budget for credential endpoints (login, register, refresh).
RATE_LIMIT_AUTH_IP=10
RATE_LIMIT_AUTH_WINDOW=15m

# ── Observability (docker compose --profile observability) ────────────────────
GRAFANA_ADMIN_PASSWORD=change-me

# ── Web push (optional) ───────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@unicore.local

# ── Escape hatch ──────────────────────────────────────────────────────────────
# Lets the API start against a database role that can bypass RLS. This turns off
# tenant isolation and is rejected outright when APP_ENV=production. Only useful
# for debugging against a throwaway database.
# ALLOW_RLS_BYPASS=false
